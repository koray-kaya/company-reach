# Every comment sits on its own line. A comment after an empty value
# (`KEY=   # note`) is read as the value itself.

# LLM — any OpenAI-compatible endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-key
LLM_MODEL=your-model-id
# json_schema | function_calling | json_mode
LLM_STRUCTURED_METHOD=json_schema
# low | high | max — per-call overridable
LLM_REASONING_EFFORT=low
# Generous: reasoning shares this budget.
LLM_MAX_TOKENS=50000
# One scoring call measured 41-130 s.
LLM_TIMEOUT_SECONDS=600
# Shared endpoint; 10 concurrent requests timed out.
LLM_CONCURRENCY=3

# Search (M4): the port `docker compose up -d searxng` publishes.
SEARXNG_URL=http://127.0.0.1:8080
# Any random string; SearXNG refuses to start without one.
SEARXNG_SECRET=change-me
# Optional, paid. Asked only when SearXNG fails or finds nothing, and
# before a company is recorded as having no website.
BRAVE_SEARCH_API_KEY=

# Limits
MAX_PAGES_PER_SITE=10
MAX_CHARS_PER_PAGE=8000
SCORE_BATCH_SIZE=50
MAX_BATCHES_PER_RUN=3

# Tracing to LangSmith — off by default; traces would contain names and
# page text. This line decides: LANGSMITH_TRACING or LANGCHAIN_TRACING_V2
# exported in the shell for another project does not turn it on here.
COMPANY_REACH_TRACING=false

# The review page's Send stays locked until this is true. Set it only once
# the approval your use needs (for a thesis: ethics approval) is given.
SENDING_APPROVED=false

# How Send opens the draft: "mailto" hands it to the computer's mail program;
# "outlook" opens Outlook on the web, filled in, in a new browser tab.
MAIL_CLIENT=mailto
# Only with MAIL_CLIENT=outlook. Microsoft 365 (school or work account) is the
# default; a personal outlook.com account uses
# https://outlook.live.com/mail/0/deeplink/compose
# OUTLOOK_COMPOSE_URL=https://outlook.office.com/mail/deeplink/compose
