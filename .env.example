# LLM — any OpenAI-compatible endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-key
LLM_MODEL=your-model-id
LLM_STRUCTURED_METHOD=json_schema      # json_schema | function_calling | json_mode
LLM_REASONING_EFFORT=low               # low | high | max — per-call overridable
LLM_MAX_TOKENS=50000                   # generous: reasoning shares this budget
LLM_TIMEOUT_SECONDS=600                # one scoring call measured 41-130 s
LLM_CONCURRENCY=3                      # shared endpoint; 10 timed out

# Search (M4)
SEARXNG_URL=http://searxng:8080     # http://127.0.0.1:8080 when not in Docker
SEARXNG_SECRET=change-me            # any random string; SearXNG refuses to start without one
SERPER_API_KEY=                        # optional, used only when SearXNG errors

# Optional JavaScript rendering (M5)
PLAYWRIGHT_URL=

# Limits
MAX_PAGES_PER_SITE=10
MAX_CHARS_PER_PAGE=8000
SCORE_BATCH_SIZE=50
MAX_BATCHES_PER_RUN=3

# Tracing — off by default; traces would contain names and page text
LANGSMITH_TRACING=false

# The review page's Send stays locked until this is true. Set it only once
# the approval your use needs (for a thesis: ethics approval) is given.
SENDING_APPROVED=false
